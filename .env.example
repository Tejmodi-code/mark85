# Copy to .env (deploy.sh does this and fills in the secrets for you).
POSTGRES_PASSWORD=change-me
ADMIN_KEY=change-me

SITE_HOST=example.com
HTTP_PORT=80
HTTPS_PORT=443
API_REPLICAS=4
ENGINE_REPLICAS=2
WEB_CONCURRENCY=4

# Adaptive JIT admission defaults, applied per API worker/live actor.
API_ADMISSION_MAX=10
API_ADMISSION_QUEUE=20
API_ADMISSION_WAIT_MS=150
API_ADMISSION_TARGET_MS=350
LIVE_ACTION_MAX_INFLIGHT=16
LIVE_ACTION_QUEUE=32
LIVE_ACTION_WAIT_MS=150
LIVE_ACTION_TARGET_MS=300
